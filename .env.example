ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
QR_SECRET=qr-gaetano-eb0d388052fd

# Solo per il servizio "listener" (WhatsApp personale, ha un suo QR/sessione).
WA_ACCOUNT_LABEL=personale

# Solo per il servizio "webhook-lavoro": protegge l'endpoint che riceve gli
# eventi dalla sessione WAHA già usata da Leo sul WhatsApp di lavoro. Non
# apre una sessione propria, quindi non serve QR per questo servizio.
WEBHOOK_SECRET=wh-gaetano-5f21858aa968

# Solo per il bot, servono a "invia_email_approvata" per mandare davvero
# un'email dopo che l'hai confermata. Vanno bene le credenziali SMTP di
# una qualsiasi delle tue caselle (Aruba, Yahoo, ecc.), non serve Gmail.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

PORT=3000
